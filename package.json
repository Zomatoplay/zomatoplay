{
  "name": "nanotron",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:backfill-tiers": "tsx src/db/scripts/backfill-plan-tiers.ts",
    "db:check": "tsx src/db/scripts/check.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test --test-concurrency=1 $(find src -name '*.test.ts')",
    "tron:inspect": "tsx --conditions=react-server src/db/scripts/tron-inspect.ts",
    "tron:scan": "tsx --conditions=react-server src/db/scripts/tron-scan.ts",
    "db:dev-accounts": "tsx src/db/scripts/dev-accounts.ts",
    "db:link-admin": "tsx src/db/scripts/dev-accounts.ts",
    "db:secure": "tsx src/db/scripts/secure.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.30.0",
    "next": "15.5.23",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
